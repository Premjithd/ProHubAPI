<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Skip trivial auto-property getters/setters (DTOs, models). -->
          <SkipAutoProps>true</SkipAutoProps>
          <!-- Exclude generated / non-testable code from the denominator. -->
          <Exclude>[ServiceProviderAPI]ServiceProviderAPI.Migrations.*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
